(function header() {
  const meta = document.getElementById("meta");
  [["Modelo", (D.model.type || "") + " · versão " + (D.model.version || "–")],
   ["Período", monthLabel(D.months[0]) + " a " + monthLabel(D.months[last])],
   ["Ponto de corte (PD)", F.d3(D.model.threshold)],
   ["Gerado em", new Date(D.generated_at).toLocaleString("pt-BR")]].forEach(([k, v]) => {
    const item = el("span", {}, meta); el("span", {}, item, k + ": "); el("b", {}, item, v);
  });
  const banner = document.getElementById("banner");
  // Sem rotulo maduro nao ha queda medida: o banner nunca trata ausencia de dado como degradacao.
  const drop = labeled < 0 ? null : ref.roc_auc - T.roc_auc[labeled];
  const level = drop != null && drop >= D.thresholds.auc_drop_critical ? "critical" : ov.alerts.critical ? "warning" : "ok";
  status(banner, level, "");
  const text = el("div", {}, banner);
  el("strong", {}, text, level === "critical" ? "Modelo degradado: ação necessária" : level === "warning" ? "Alertas críticos no período: modelo em observação" : "Modelo estável");
  const performance = labeled < 0
    ? ". Nenhuma remessa tem rótulo maduro ainda; a performance do modelo não pôde ser medida."
    : ". O ROC AUC foi de " + F.d3(ref.roc_auc) + " na referência para " + F.d3(T.roc_auc[labeled]) + " em " + monthLabel(D.months[labeled]) +
      " e a inadimplência entre os aprovados, de " + F.pct(ref.bad_rate_approved) + " para " + F.pct(T.bad_rate_approved[labeled]) + ".";
  el("span", { class: "lede" }, text,
    "Primeiro alerta de drift de dados em " + (ov.first_drift_alert ? monthLabel(ov.first_drift_alert) : "–") +
    "; primeira queda de performance em " + (ov.first_performance_alert ? monthLabel(ov.first_performance_alert) : "–") + performance);
})();

