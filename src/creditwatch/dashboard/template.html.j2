      F.pct(R.champion_approval_rate) + ").";
    table(document.getElementById("remediation"), [
      { label: "Estratégia", value: (k) => (R.strategy_labels || {})[k] || k },
      { label: "ROC AUC", num: true, value: (k) => F.d3(R.strategies[k].roc_auc) },
      { label: "KS", num: true, value: (k) => F.d3(R.strategies[k].ks) },
      { label: "Aprovação", num: true, value: (k) => F.pct(R.strategies[k].approval_rate) },
      { label: "Inadimpl. (mesmo volume)", num: true, value: (k) => F.pct(R.strategies[k].bad_rate_at_champion_approval) },
    ], Object.keys(R.strategies));
  }
  const attr = { sex: "Sexo", age_band: "Faixa etária", education: "Escolaridade", marriage: "Estado civil" };
  const verdict = { "impacto adverso": ["critical", "Impacto adverso"], "inconclusivo": ["warning", "Inconclusivo"], "dentro do limite": ["ok", "Dentro do limite"] };
  table(document.getElementById("fairness"), [
    { label: "Período", value: (f) => D.phase_labels[f.period] || f.period },
    { label: "Atributo", value: (f) => attr[f.attribute] || f.attribute },
    { label: "Grupo menos aprovado", value: (f) => f.group + " (n = " + F.int(f.n) + ")" },
    { label: "Impacto desigual (IC 95%)", num: true, value: (f) => F.d2(f.disparate_impact) + " (" + F.d2(f.disparate_impact_ci[0]) + " a " + F.d2(f.disparate_impact_ci[1]) + ")" },
    { label: "Situação", value: (f) => { const s = document.createElement("span"), v = verdict[f.verdict] || ["ok", f.verdict]; status(s, v[0], v[1]); return s; } },
  ], A.fairness || []);
})();

table(document.getElementById("all-alerts"), alertColumns(true), D.alerts);
document.getElementById("footer").textContent =
  "creditwatch " + D.package_version + " · dashboard gerado a partir de reports/monitoring, reports/observability e reports/analysis. " +
  "Dataset: Default of Credit Card Clients (UCI, CC BY 4.0).";

drawCharts();
let resizeTimer, lastWidth = document.querySelector("main").clientWidth;
new ResizeObserver((entries) => {
  const width = Math.round(entries[0].contentRect.width);
  if (width === lastWidth) return;  // so a largura muda o desenho; ignora mudancas de altura
  lastWidth = width;
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(drawCharts, 150);
}).observe(document.querySelector("main"));
</script>
{% endraw %}
</body>
</html>
