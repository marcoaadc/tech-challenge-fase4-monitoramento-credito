# Copie para .env e ajuste se necessario. Todas as chaves tem defaults sensatos.
# Prefixo CREDITWATCH_ (pydantic-settings).

# Diretorios
CREDITWATCH_DATA_DIR=data
CREDITWATCH_MODELS_DIR=models
CREDITWATCH_REPORTS_DIR=reports
CREDITWATCH_LOGS_DIR=logs

# Reprodutibilidade
CREDITWATCH_SEED=42
CREDITWATCH_LOG_LEVEL=INFO

# Particao referencia x producao
CREDITWATCH_REFERENCE_FRACTION=0.5
CREDITWATCH_BATCH_SIZE=2000
CREDITWATCH_LABEL_LAG_MONTHS=2          # meses ate o rotulo de um lote amadurecer

# Limiares de drift (docs/observabilidade.md)
CREDITWATCH_PSI_WARNING=0.10
CREDITWATCH_PSI_CRITICAL=0.25
CREDITWATCH_KS_EFFECT_SIZE=0.10
CREDITWATCH_P_VALUE_ALPHA=0.05
CREDITWATCH_DRIFT_SHARE_ALERT=0.30

# Limiares de degradacao do modelo
CREDITWATCH_AUC_DROP_WARNING=0.03
CREDITWATCH_AUC_DROP_CRITICAL=0.05
CREDITWATCH_CALIBRATION_GAP_ALERT=0.05

# Observabilidade (vazio = desativado)
# CREDITWATCH_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
CREDITWATCH_MLFLOW_EXPERIMENT_TRAINING=creditwatch-treino
CREDITWATCH_MLFLOW_EXPERIMENT_MONITORING=creditwatch-monitoramento
CREDITWATCH_MLFLOW_REGISTERED_MODEL=credit-scoring-baseline
# CREDITWATCH_PUSHGATEWAY_URL=http://localhost:9091
